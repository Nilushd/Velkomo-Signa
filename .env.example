# --- Database (Supabase Postgres) ---------------------------------------------
# Supabase → Project Settings → Database → Connection string (URI).
# Use the "Transaction pooler" URI (port 6543) on Vercel.
DATABASE_URL=postgres://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Secret used to encrypt two-factor keys (any long random string; keep it stable)
AUTH_SECRET=change-me-to-a-long-random-string

# Fallback time zone only — each hotel has its own, chosen in the Platform when the hotel is created
NEXT_PUBLIC_TIMEZONE=Asia/Colombo

# --- File storage (recommended on Vercel) ---------------------------------------
# With these set, attachments and logos go to Supabase Storage instead of the database: browsers upload
# straight to storage (no 4.5 MB Vercel limit) and downloads use short-lived signed links.
# Create a PRIVATE bucket named below in Supabase → Storage. Without them, files are kept in the database (dev).
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=signa-files

# Public URL of the app (used in e-mail links and QR codes)
APP_URL=https://signa.example.com

# --- E-mail: set ONE of these. With neither, e-mails are only logged (email_log table + console).
RESEND_API_KEY=
EMAIL_FROM="Velkomo Signa <signa@yourdomain.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Web Push (generate with: npx web-push generate-vapid-keys) --------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- hCaptcha on public forms (optional; skipped when empty) ------------------
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# --- Daily reminder cron (Vercel sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=change-me-to-a-long-random-string

# --- Form Studio: AI design (optional) ---------------------------------------
# With a key, Form Studio can also read photos/scans of paper forms and redo any design with Claude.
# Without it, Excel and PDF samples are designed by built-in rules (no AI).
ANTHROPIC_API_KEY=

# --- Seed script only ---------------------------------------------------------
# SEED_PASSWORD=Welcome123
